{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode-classic",
    "mode": "dark"
  },
  "plugins": [
    "./plugins/subagent-statusline.v2",
    "./plugins/open-editor",
    "./plugins/image-preview"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "image_preview": true,
    "permissions": "prompt"
  },
  "debug": {
    "turn_tokens": true
  },
  "prompt": {
    "editor": false,
    "image_preview": true
  },
  "scroll": {
    "acceleration": false
  },
  "keybinds": {
    "session.page.up": "<leader>k",
    "session.page.down": "<leader>j"
  },
  "animations": true
}
