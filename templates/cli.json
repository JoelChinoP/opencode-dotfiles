{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "plugins": [
    "./plugins/subagent-statusline.v2"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "debug": {
    "turn_tokens": true
  },
  "prompt": {
    "editor": false
  },
  "keybinds": {
    "session.page.up": "<leader>k",
    "session.page.down": "<leader>j"
  },
  "animations": true
}
