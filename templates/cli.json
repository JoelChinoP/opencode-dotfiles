{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "opencode",
    "mode": "dark"
  },
  "plugins": [
    "./plugins/subagent-statusline.v2"
  ],
  "diffs": {
    "source": "working",
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "prompt"
  },
  "debug": {
    "turn_tokens": "true"
  },
  "prompt": {
    "editor": false
  },
  "animations": true
}