{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "hostname": "127.0.0.1",
    "port": 4096
  },
  "default_agent": "build",
  "plugin": [
    "@dietrichgebert/ponytail@4.8.4"
  ],
  "mcp": {
    "engram": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/engram",
        "mcp",
        "--tools=agent"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true,
      "timeout": 15000
    },
    "codegraph": {
      "type": "local",
      "enabled": false,
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "cwd": ".",
      "timeout": 15000,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "{env:HOME}/.opencode-skills/node/node_modules/@playwright/mcp/cli.js"
      ]
    }
  },
  "permission": {
    "edit": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "task": "ask",
    "skill": {
      "*": "allow"
    },
    "read": {
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/*.pem": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "sudo": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -rf /*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "dd of=/dev/*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "curl * | sh*": "deny",
      "curl * | bash*": "deny",
      "wget * | sh*": "deny",
      "wget * | bash*": "deny",
      "chmod -R 777 *": "deny",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "less *": "allow",
      "more *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "fgrep *": "allow",
      "egrep *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "which *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "awk *": "allow",
      "sed -n *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch -*": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git config --get *": "allow",
      "git stash list": "allow",
      "git stash list *": "allow",
      "git blame *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh search *": "allow",
      "gh api *": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "node *": "allow",
      "deno *": "allow",
      "bun *": "allow",
      "go run *": "allow",
      "go test *": "allow",
      "go build *": "allow",
      "cargo check*": "allow",
      "cargo build*": "allow",
      "cargo test*": "allow",
      "make": "allow",
      "make *": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm start*": "allow",
      "pnpm run *": "allow",
      "pnpm test*": "allow",
      "pnpm start*": "allow",
      "yarn run *": "allow",
      "yarn test*": "allow",
      "yarn start*": "allow",
      "bun run *": "allow",
      "bun test*": "allow",
      "mkdir *": "allow",
      "mkdir -p *": "allow",
      "cp *": "allow",
      "cp -r *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "ln -s*": "allow",
      "libreoffice *": "allow",
      "soffice *": "allow",
      "pdftoppm *": "allow",
      "pdftotext *": "allow",
      "qpdf *": "allow",
      "tesseract *": "allow",
      "pandoc *": "allow",
      "gs *": "allow",
      "ghostscript *": "allow",
      "convert *": "allow",
      "magick *": "allow",
      "ffmpeg -i *": "allow",
      "ffmpeg -version": "allow",
      "playwright *": "allow"
    }
  }
}
